{
  "name": "pixel-office-desktop",
  "productName": "Pixel Office",
  "version": "0.1.0",
  "description": "Pixel Office desktop app (Electron)",
  "author": "Pixel Office",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "pixelOffice": {
    "defaultUrl": "http://localhost:3000"
  },
  "scripts": {
    "setup": "npm ci && node node_modules/electron/install.js",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "jp.example.pixeloffice",
    "productName": "Pixel Office",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "offline.html",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSCameraUsageDescription": "ビデオ通話でカメラを使います",
        "NSMicrophoneUsageDescription": "音声通話でマイクを使います"
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  }
}
