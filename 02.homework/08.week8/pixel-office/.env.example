# Copy to .env and edit. Never commit .env.

APP_PORT=3000
# 1 when the app is behind CloudFront or an ALB
TRUST_PROXY=0
# Extra origins allowed to connect (comma separated), usually empty
ALLOWED_ORIGINS=
# Secret value CloudFront sends as the header X-Origin-Secret (openssl rand -hex 32).
# When set, requests that do not come through CloudFront are refused.
ORIGIN_SECRET=
# Spaces (chat, sticky notes, whiteboards, files) are saved and kept.
# Delete spaces nobody entered for this many days (0 = keep forever)
SPACE_RETENTION_DAYS=0
# Most spaces kept on the server, and total size of uploaded files (MB)
MAX_STORED_SPACES=1000
MAX_TOTAL_STORAGE_MB=10240

# STUN servers handed to browsers (JSON). Empty = Google's public STUN.
ICE_SERVERS=

# TURN relay (optional, for docker-compose.turn.yml). Never put TURN passwords in ICE_SERVERS:
# the app makes a temporary password for each person from TURN_SECRET.
#   TURN_SECRET: a long random string, e.g. the output of: openssl rand -hex 32
#   TURN_URLS:   comma separated, e.g. turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp
TURN_SECRET=
TURN_URLS=
TURN_EXTERNAL_IP=
